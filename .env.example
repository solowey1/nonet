# Copy to `.env` and fill in. Every variable any service reads is documented
# here — see §18. `docker-compose.yml` passes this whole file to the api and
# bot containers via `env_file`.

# ---- Postgres (used directly by the postgres container, and to build the
#      api's DATABASE_URL below) ----
POSTGRES_USER=nonet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nonet

# ---- api (apps/api) ----
# Only read when running the api OUTSIDE docker-compose (e.g. `pnpm --filter
# @nonet/api dev` against a local Postgres) — inside compose, the `api`
# service's DATABASE_URL is computed from the POSTGRES_* vars above and the
# `postgres` service hostname, so this line is ignored there.
DATABASE_URL=postgres://nonet:change-me@localhost:5432/nonet

# Telegram bot token (from @BotFather) — used server-side to validate
# `initData` (§12) and by the bot service to call the Bot API. Must be the
# *same* token in both places.
BOT_TOKEN=123456:your-bot-token-here

# Signing secret for session/run JWTs. Generate with e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# How long a session token stays valid before the client must re-auth via
# initData. Optional — defaults shown.
SESSION_TOKEN_TTL_SECONDS=3600
# How long a run token stays valid for checkpoint/finish calls on that run.
RUN_TOKEN_TTL_SECONDS=21600
# Reject initData whose auth_date is older than this when minting a session (§12).
INIT_DATA_MAX_AGE_SECONDS=900

# ---- bot (apps/bot) ----
# Arbitrary secret you choose; passed to Telegram's `setWebhook` and checked
# against the `X-Telegram-Bot-Api-Secret-Token` header on every delivery (§12).
WEBHOOK_SECRET=change-me-to-another-random-string
# Where the "Play NONET" button opens — the Mini App's public origin.
WEBAPP_URL=https://your-domain.example
# If set, the bot calls `setWebhook` with this URL on boot. Leave unset in
# local dev; set it once you have a public HTTPS URL for the bot's /tg/webhook.
# PUBLIC_WEBHOOK_URL=https://your-domain.example/tg/webhook

# ---- web (apps/web via docker-compose) ----
# Host port docker-compose publishes the `Nonet` (web) container's nginx on.
# Production typically sits behind the host's existing certbot/reverse-proxy
# setup (§18) rather than exposing this port directly — adjust accordingly.
WEB_PORT=8080
